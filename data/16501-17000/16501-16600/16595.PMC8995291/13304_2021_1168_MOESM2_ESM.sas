proc sgplot data=orciC;
 scatter x=oddsratio y=effect / xerrorlower=lowerci
	xerrorupper=upperci
	markerattrs=(symbol=DiamondFilled size=8);
 refline 1 / axis=x;
 xaxis label="Odds Ratio and 95% CI " min=0.001 max=1000
	TYPE=LOG LOGSTYLE=LOGEXPAND LOGBASE=10;
 yaxis display=(NOLABEL);
run;
ods graphics on / reset=all;
TITLE 'MODEL D: RIGOUR AND STRENGTH OF RECOMMENDATION ONLY: HIERARCHICAL LOGISTIC REGRESSION';
ods output ParameterEstimates=orciD;
PROC GLIMMIX DATA=DataForAnalysis METHOD=LAPLACE NOCLPRINT plots=all;
	FORMAT differenceinrating differenceinrating.;
	FORMAT FinalRecommendation FinalRecommendation.;
	CLASS differenceinrating(ref="No") guidelineid	FinalRecommendation(ref="Weak");
	MODEL differenceinrating = rigour	FinalRecommendation/CL DIST=BINARY LINK=LOGIT SOLUTION;
	RANDOM INTERCEPT / SUBJECT=guidelineid S CL TYPE=VC;
	COVTEST /WALD;
	output out=glmmout pred=xbeta pred(ilink)=predprob; 
RUN;
proc logistic data=glmmout;
	FORMAT differenceinrating differenceinrating.;
	model differenceinrating(ref="No") = / nofit; 
	roc "GLIMMIX model" pred=predprob;
RUN;
data orciD;set orciD;
if estimate=0 then delete;
effect=upcase(effect);
if effect="INTERCEPT" then delete;
oddsratio=exp(estimate);
lowerci=exp(lower);
upperci=exp(upper);
RUN;
title "MODEL D (RIGOUR AND STRENGTH OF RECOMMENDATION ONLY: HIERARCHICAL LOGISTIC REGRESSION): Forest Plots";
ods graphics on / width=7in height=1.2in;
proc sgplot data=orciD;
 scatter x=oddsratio y=effect / xerrorlower=lowerci
	xerrorupper=upperci
	markerattrs=or
	(symbol=DiamondFilled size=8);
 refline 1 / axis=x;
 xaxis label="Odds Ratio and 95% CI " min=0.001 max=1000
	TYPE=LOG LOGSTYLE=LOGEXPAND LOGBASE=10;
 yaxis display=(NOLABEL);
run;
