ods output ParameterEstimates=orciA;
PROC GLIMMIX DATA=DataForAnalysis METHOD=LAPLACE NOCLPRINT plots=all;
	FORMAT differenceinrating differenceinrating.;
	FORMAT FinalRecommendation FinalRecommendation.;
	FORMAT GradeSystem GradeSystem.;
	CLASS differenceinrating(ref="No") guidelineid	FinalRecommendation(ref="Weak")	GradeSystem(ref="Other");
	MODEL differenceinrating = rigour clarity independence	FinalRecommendation	GradeSystem/CL DIST=BINARY LINK=LOGIT SOLUTION;
	COVTEST /WALD;
	output out=glmmout pred=xbeta pred(ilink)=predprob; 
RUN;
